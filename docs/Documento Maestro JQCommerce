CREATE TABLE clientes (
    dni VARCHAR(8) PRIMARY KEY,
    nombre VARCHAR(100),
    edad INT,
    fecha_nacimiento DATE,
    segmento_cliente VARCHAR(20), -- Niños, Adolescentes, Adultos
    email VARCHAR(100),
    telefono VARCHAR(20),
    direccion VARCHAR(200),
    fecha_registro DATE
);


-- Insertar 50 registros de prueba
INSERT INTO clientes (dni, nombre, edad, fecha_nacimiento, segmento_cliente, email, telefono, direccion, fecha_registro)
SELECT 
    LPAD(i::text, 8, '0'),
    'Cliente ' || i,
    (10 + i % 50),
    CURRENT_DATE - (i || ' years')::interval,
    CASE WHEN i % 3 = 0 THEN 'Niños' WHEN i % 3 = 1 THEN 'Adolescentes' ELSE 'Adultos' END,
    'cliente' || i || '@correo.com',
    '999999' || i,
    'Direccion ' || i,
    CURRENT_DATE - (i || ' days')::interval
FROM generate_series(1,50) AS s(i);


