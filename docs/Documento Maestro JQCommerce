PostgreSQL (cabecera + detalle)
-- Tabla cabecera de pedidos
CREATE TABLE pedidos (
    id_pedido SERIAL PRIMARY KEY,
    dni_cliente VARCHAR(8),
    fecha_pedido DATE,
    estado VARCHAR(20),
    metodo_pago VARCHAR(30),
    direccion_entrega VARCHAR(200),
    observaciones TEXT,
    total DECIMAL(10,2)
);

CREATE TABLE detalle_pedido (
    id_detalle SERIAL PRIMARY KEY,
    id_pedido INT REFERENCES pedidos(id_pedido),
    id_producto INT,
    cantidad INT,
    precio_unitario DECIMAL(10,2),
    descuento DECIMAL(10,2),
    impuesto_aplicado DECIMAL(10,2),
    subtotal DECIMAL(10,2),
    observaciones TEXT
);

-- Insertar 10 pedidos con 10 artículos cada uno
INSERT INTO pedidos (dni_cliente, fecha_pedido, estado, metodo_pago, direccion_entrega, observaciones, total)
SELECT LPAD(i::text, 8, '0'),
       CURRENT_DATE - (i || ' days')::interval,
       CASE WHEN i % 3 = 0 THEN 'Pendiente' WHEN i % 3 = 1 THEN 'Pagado' ELSE 'Enviado' END,
       CASE WHEN i % 2 = 0 THEN 'Tarjeta' ELSE 'Efectivo' END,
       'Direccion entrega ' || i,
       'Observaciones pedido ' || i,
       (i * 50.0)
FROM generate_series(1,10) AS s(i);

INSERT INTO detalle_pedido (id_pedido, id_producto, cantidad, precio_unitario, descuento, impuesto_aplicado, subtotal, observaciones)
SELECT 
    ((i-1)/10)+1,
    (i % 50) + 1,
    (i % 5) + 1,
    (i * 2.5),
    (i % 2) * 5.0,
    (i * 0.18),
    ((i % 5) + 1) * (i * 2.5) - ((i % 2) * 5.0),
    'Detalle ' || i
FROM generate_series(1,100) AS s(i);




4. Inventario → Redis
CREATE TABLE inventario (
    id_inventario SERIAL PRIMARY KEY,
    id_producto INT,
    cantidad INT,
    ubicacion_almacen VARCHAR(100),
    lote VARCHAR(50),
    fecha_actualizacion DATE
);


# Redis cache en tiempo real
for i in {1..50}; do
  redis-cli HSET inventario:$i id_producto $i cantidad $((i*5)) ubicacion "Almacen Central" lote "Lote-$i" fecha_actualizacion "$(date +%F)";
done

-- Insertar 50 registros en PostgreSQL
INSERT INTO inventario (id_producto, cantidad, ubicacion_almacen, lote, fecha_actualizacion)
SELECT 
    i,
    (i*5),
    'Almacen Central',
    'Lote-' || i,
    CURRENT_DATE
FROM generate_series(1,50) AS s(i);



5. Facturación → PostgreSQL

CREATE TABLE facturacion (
    id_factura SERIAL PRIMARY KEY,
    id_pedido INT,
    fecha_emision DATE,
    monto DECIMAL(10,2),
    tipo_documento VARCHAR(20), -- Boleta / Factura
    metodo_pago VARCHAR(30),
    estado_pago VARCHAR(20), -- Pendiente / Pagado
    estado VARCHAR(20),
    comprobante VARCHAR(20)
);


-- Insertar 50 facturas de prueba
INSERT INTO facturacion (id_pedido, fecha_emision, monto, tipo_documento, metodo_pago, estado_pago, estado, comprobante)
SELECT 
    (i % 10) + 1,
    CURRENT_DATE - (i || ' days')::interval,
    (i * 25.5),
    CASE WHEN i % 2 = 0 THEN 'Factura' ELSE 'Boleta' END,
    CASE WHEN i % 2 = 0 THEN 'Tarjeta' ELSE 'Efectivo' END,
    CASE WHEN i % 2 = 0 THEN 'Pagado' ELSE 'Pendiente' END,
    CASE WHEN i % 2 = 0 THEN 'Emitida' ELSE 'Pagada' END,
    'FAC-' || LPAD(i::text, 6, '0')
FROM generate_series(1,50) AS s(i);



